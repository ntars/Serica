set -eu

fail() {
    printf '%s\n' "$*" >&2
    exit 1
}

[ "$#" -eq 3 ] && [ "$2" = "-o" ] && [ -n "$1" ] && [ -n "$3" ] ||
    fail "用法：tools/build-serica-native <源码> -o <产物>"
[ "$(uname -s):$(uname -m)" = "Darwin:arm64" ] || fail "当前发射器只支持 macOS arm64"

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
analyze="$root/build/serica-native/analyze"
emit="$root/build/serica-native/emit-console"
[ -x "$analyze" ] && [ -x "$emit" ] || fail "先构建行简发射工具 make native-tools"

source_dir=$(CDPATH= cd -- "$(dirname -- "$1")" && pwd -P)
source_name=$(basename -- "$1")
source="$source_dir/$source_name"
[ -f "$source" ] || fail "源码文件不存在：$source"
output_dir=$(CDPATH= cd -- "$(dirname -- "$3")" && pwd -P)
output="$output_dir/$(basename -- "$3")"
if [ -d "$output" ] || [ -L "$output" ] || [ "$source" -ef "$output" ]; then
    fail "产物路径须为独立的普通文件路径：$output"
fi

work=$(mktemp -d "$output_dir/.serica-native.XXXXXXXX")
cleanup() {
    rm -f -- "$work/payload" "$work/program"
    rmdir -- "$work"
}
trap cleanup 0
trap 'exit 1' HUP INT TERM

analyze_mode() {
    printf '%s\n' -1 | "$analyze" "$source_name" "$1" "$source_dir" "$work/payload"
}

status=$(analyze_mode native-data) || fail "行简前端执行失败"
runtime=0
case "$status" in
    -*)
        diagnostic=${status#-}
        case "$diagnostic" in ''|*[!0-9]*) fail "前端返回无效诊断" ;; esac
        if [ "$((diagnostic & 8191))" -eq 3080 ]; then
            status=$(analyze_mode native-code) || fail "行简运行时降级失败"
            runtime=1
        fi
        ;;
esac
case "$status" in
    -*)
        number=${status#-}
        case "$number" in ''|*[!0-9]*) fail "前端返回无效诊断" ;; esac
        printf '原生发射拒绝 S-%04d（模块 %d，UTF-8 字节 %d）\n' \
            "$((number & 8191))" "$((number >> 37))" "$(((number >> 13) & 16777215))" >&2
        exit 1
        ;;
    ''|*[!0-9]*) fail "前端返回无效长度" ;;
esac
[ "$status" -gt 0 ] && [ -f "$work/payload" ] && [ "$status" -eq "$(stat -f %z "$work/payload")" ] ||
    fail "前端载荷长度无效"

set -- "$work/payload" "$work/program"
if [ "$runtime" -eq 1 ]; then
    set -- "$@" runtime
fi
size=$("$emit" "$@") || fail "行简 Mach-O 发射失败"
case "$size" in ''|*[!0-9]*) fail "发射器拒绝载荷：$size" ;; esac
[ "$size" -gt 0 ] && [ -f "$work/program" ] && [ "$size" -eq "$(stat -f %z "$work/program")" ] ||
    fail "Mach-O 长度无效"
chmod 0755 "$work/program"
codesign -s - --force --timestamp=none "$work/program"
codesign --verify --strict "$work/program"
mv -f -- "$work/program" "$output"
printf '行简已生成 macOS arm64 程序：%s\n' "$output"
