若（argumentCount（）>2）【
若（equals（argumentText（2），『program』））【赋值 程序模式=1。】。
若（equals（argumentText（2），『module』））【赋值 程序模式=2。】。
若（equals（argumentText（2），『bind-program』））【赋值 程序模式=1。赋值 绑定模式=1。】。
若（equals（argumentText（2），『bind-module』））【赋值 程序模式=2。赋值 绑定模式=1。】。
若（equals（argumentText（2），『imports』））【赋值 程序模式=1。赋值 导入模式=1。】。
若（equals（argumentText（2），『module-imports』））【赋值 程序模式=2。赋值 导入模式=1。】。
若（equals（argumentText（2），『read-import』））【赋值 程序模式=1。赋值 导入模式=2。】。
若（equals（argumentText（2），『read-module-import』））【赋值 程序模式=2。赋值 导入模式=2。】。
若（equals（argumentText（2），『module-graph』））【赋值 程序模式=1。赋值 导入模式=1。赋值 图模式=1。】。
若（equals（argumentText（2），『module-bind』））【赋值 程序模式=1。赋值 导入模式=1。赋值 图模式=1。赋值 绑定模式=2。】。
若（equals（argumentText（2），『module-effect』））【赋值 程序模式=1。赋值 导入模式=1。赋值 图模式=1。赋值 绑定模式=2。赋值 效果模式=1。】。
若（equals（argumentText（2），『module-type』））【赋值 程序模式=1。赋值 导入模式=1。赋值 图模式=1。赋值 绑定模式=2。赋值 效果模式=1。赋值 类型模式=1。】。
若（equals（argumentText（2），『module-const』））【赋值 程序模式=1。赋值 导入模式=1。赋值 图模式=1。赋值 绑定模式=2。赋值 效果模式=1。赋值 类型模式=1。赋值 常值模式=1。】。
若（equals（argumentText（2），『module-abi』））【赋值 程序模式=1。赋值 导入模式=1。赋值 图模式=1。赋值 绑定模式=2。赋值 效果模式=1。赋值 类型模式=1。赋值 常值模式=1。赋值 签模式=1。】。
若（equals（argumentText（2），『native-data』））【赋值 程序模式=1。赋值 导入模式=1。赋值 图模式=1。赋值 绑定模式=2。赋值 效果模式=1。赋值 类型模式=1。赋值 常值模式=1。赋值 发射模式=1。】。
若（equals（argumentText（2），『native-code』））【赋值 程序模式=1。赋值 导入模式=1。赋值 图模式=1。赋值 绑定模式=2。赋值 效果模式=1。赋值 类型模式=1。赋值 常值模式=1。赋值 签模式=1。赋值 发射模式=2。】。
】。

